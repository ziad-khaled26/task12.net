@{
    ViewData["Title"] = "Home Page";
}

<div class="d-flex justify-content-center align-items-center mt-5">
    <div class="card shadow-lg p-5 text-center" style="border-radius: 15px; background: rgba(255, 255, 255, 0.95); max-width: 800px;">
        <h1 class="display-4 fw-bold">Welcome to ToDoListApp</h1>
        <p class="lead mt-3 text-muted">Organize your tasks, manage deadlines, and track your progress effortlessly. Our app helps you stay productive and focused every day.</p>
        <div class="mt-4 mb-5">
            <a href="/TodoItem/Index" class="btn btn-primary btn-lg" style="background-color: #5b21b6; border: none; border-radius: 8px;">View Your Tasks</a>
        </div>
        <div class="text-start mt-4">
            <p><strong>Why use ToDoListApp?</strong> Because keeping track of your daily tasks shouldn't be a hassle. With our clean and simple interface, you can add, edit, and delete tasks with ease.</p>
            <p><strong>Stay on top of deadlines:</strong> The app highlights urgent tasks so you never miss important deadlines. You can filter by date and quickly see what's due soon.</p>
            <p><strong>File attachments:</strong> Upload files to your tasks and access them directly from the app. Everything is organized in one place for maximum efficiency.</p>
        </div>
    </div>
</div>